      "source": [
        "from sklearn.metrics import log_loss\n",
        "\n",
        "# Sample data\n",
        "y_true = [1, 0, 1, 0]  # Actual labels\n",
        "y_pred = [0.9, 0.2, 0.6, 0.8]  # Predicted probabilities\n",
        "\n",
        "# Calculate Log Loss\n",
        "loss = log_loss(y_true, y_pred)\n",
        "print(f\"Log Loss: {loss:.4f}\")\n",
        "\n",
        "\n"
      ],
